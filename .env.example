PORT=3000

# RSA key pair, e.g. generated from https://cryptotools.net/rsagen
# Option 1: paths to PEM files (default: keys/private.pem and keys/public.pem)
RSA_PRIVATE_KEY_PATH=keys/private.pem
RSA_PUBLIC_KEY_PATH=keys/public.pem

# Option 2: inline PEMs (take precedence over the paths). Escape newlines as \n.
# RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
# RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"
